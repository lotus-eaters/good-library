# ── Database ───────────────────────────────────────────────────────────────────
# Format: postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DATABASE_NAME
DATABASE_URL=postgresql+asyncpg://good_library_user:your_password@localhost:5432/good_library

# ── Security ───────────────────────────────────────────────────────────────────
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-64-char-random-hex-string
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── External APIs ──────────────────────────────────────────────────────────────
# Get your key at: https://console.cloud.google.com → Enable Books API → Credentials
GOOGLE_BOOKS_API_KEY=your-google-books-api-key-here

# ── App ────────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173

# ── Stage 2 (leave blank for now) ─────────────────────────────────────────────

